<fieldset class="rmu-light-settings">
    <legend>{{localize "rmu.light.settingsHeader"}}</legend>

    <div class="form-group">
        <label>
            {{localize "rmu.light.baseIllumination"}}
            <i class="rmu-lighting-icon info" data-tooltip="{{localize 'rmu.light.baseIlluminationHint'}}"></i>
        </label>
        <div class="form-fields">
            <select name="flags.rmu-lighting-vision.baseIllumination">
                {{selectOptions baseIlluminationOptions selected=currentBase}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>
            {{localize "rmu.light.isMagical"}}
            <i class="rmu-lighting-icon info" data-tooltip="{{localize 'rmu.light.isMagicalHint'}}"></i>
        </label>
        <div class="form-fields" style="flex: 0;">
            <input type="checkbox" name="flags.rmu-lighting-vision.isMagical" class="rmu-magical-cb" {{checked isMagical}} />
        </div>
    </div>

    <div class="form-group">
        <label>
            {{localize "rmu.light.isUtter.name"}}
            <i class="rmu-lighting-icon info" data-tooltip="{{localize 'rmu.light.isUtter.hint'}}"></i>
        </label>
        <div class="form-fields" style="flex: 0;">
            <input type="checkbox" name="flags.rmu-lighting-vision.isUtter" class="rmu-utter-cb" {{checked isUtter}} />
        </div>
    </div>

    <div class="form-group">
        <label>
            {{localize "rmu.light.isConstant.name"}}
            <i class="rmu-lighting-icon info" data-tooltip="{{localize 'rmu.light.isConstant.hint'}}"></i>
        </label>
        <div class="form-fields" style="flex: 0;">
            <input type="checkbox" name="flags.rmu-lighting-vision.isConstant" class="rmu-constant-cb" {{checked isConstant}} />
        </div>
    </div>

</fieldset>